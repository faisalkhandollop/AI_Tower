# Tower AI Enterprise Platform v5.0
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET YOUR SUPABASE CONNECTION STRING:
#   1. Go to supabase.com → your project
#   2. Click Settings → Database
#   3. Scroll to "Connection string" → select URI tab
#   4. Copy it — looks like:
#      postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#   5. Paste it below as DATABASE_URL
#
# Generate VAULT_ENC_KEY (run this once, save the output):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate JWT_SECRET_KEY (run this once, save the output):
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Replace [PASSWORD] and [REF] with your actual Supabase values
# ?sslmode=require is mandatory for Supabase
DATABASE_URL=postgresql://postgres.tjrdcszcfhrourqgetxv:lokeshbarfa@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-output-of-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Encryption (AES-256-GCM) ─────────────────────────────────────────────────
# CRITICAL: Replace with output of: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value to git
# NEVER change this after you have encrypted vault keys — they will become unreadable
VAULT_ENC_KEY=replace-with-output-of-secrets-token-hex-32

# ── AI Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── AI Router (Ollama — optional, only if you run Ollama locally) ─────────────
OLLAMA_URL=http://localhost:11434

# ── Platform ──────────────────────────────────────────────────────────────────
UNIFIED_BASE_URL=http://localhost:8000